(ert-deftest my/key-observer-repeat-and-macro-invocations-retain-their-sources ()
  (my/key-observer-test--isolated
    (with-temp-buffer
      (my/key-observer-test--input 'evil-repeat (kbd "."))
      (my/key-observer--repeat-a
       (lambda () (my/key-observer-test--input 'self-insert-command [97])))
      (my/key-observer-test--input 'evil-execute-macro (kbd "@ a"))
      (let ((executing-kbd-macro [97]))
        (my/key-observer-test--input 'self-insert-command [97]))
      (should (equal (mapcar (lambda (record) (plist-get record :source))
                             (reverse my/key-observer--pending))
                     '("manual" "repeat" "manual" "macro")))
      (should (equal (mapcar (lambda (record) (plist-get record :phase))
                             (reverse my/key-observer--pending))
                     '("invocation" nil "invocation" nil))))))

(ert-deftest my/key-observer-minibuffer-context-and-keycast-omissions ()
  (my/key-observer-test--isolated
    (with-temp-buffer
      (let ((this-original-command 'consult-line)
            (my/key-observer-test--keys (kbd "SPC s s")))
        (my/key-observer--pre-h)
        (cl-letf (((symbol-function 'recursion-depth) (lambda () 1)))
          (let ((major-mode 'minibuffer-mode))
            (my/key-observer-test--input 'self-insert-command [97])))
        (should (equal (plist-get (gethash 0 my/key-observer--contexts) :invocation)
                       "SPC s s")))
      (let ((keycast-substitute-alist '((self-insert-command nil nil))))
        (my/key-observer-test--input 'self-insert-command [115]))
      (should (= (length my/key-observer--pending) 1))
      (should (equal (plist-get (car my/key-observer--pending) :mode) "minibuffer-mode")))))

(ert-deftest my/key-observer-refreshes-only-changed-visible-controls ()
  (my/key-observer-test--isolated
    (let ((renders 0) (updates 0) (visible nil))
      (get-buffer-create my/key-observer--panel)
      (cl-letf (((symbol-function 'get-buffer-window) (lambda (&rest _) visible))
                ((symbol-function 'force-mode-line-update) (lambda (&rest _) (cl-incf updates)))
                ((symbol-function 'my/key-observer--render)
                 (lambda ()
                   (cl-incf renders)
                   (setq my/key-observer--panel-state (my/key-observer--panel-state-key)))))
        (my/key-observer--refresh)
        (should (= renders 0))
        (should (= updates 1))
        (setq visible t)
        (dotimes (_ 3) (my/key-observer--refresh))
        (should (= renders 1))
        (should (= updates 1))
        (my/key-observer-test--queue 1)
        (my/key-observer--refresh)
        (should (= renders 2))
        (should (= updates 1))))))

(ert-deftest my/key-observer-reload-retains-checkpoint-deadline-and-one-registration ()
  (my/key-observer-test--isolated
    (dotimes (_ 3) (my/key-observer--activate))
    (should (= (cl-count #'my/key-observer--pre-h pre-command-hook) 1))
    (should (= (cl-count #'my/key-observer--post-h post-command-hook) 1))
    (let ((count 0))
      (advice-mapc (lambda (function _properties)
                     (when (eq function #'my/key-observer--password-a) (cl-incf count)))
                   'read-passwd)
      (should (= count 1)))
    (my/key-observer-test--queue 1)
    (my/key-observer--periodic-save-h)
    (my/key-observer--begin-checkpoint)
    (my/key-observer-test--queue 2)
    (let* ((session my/key-observer--session)
           (checkpoint my/key-observer--checkpoint)
           (pending my/key-observer--pending)
           (timer my/key-observer--save-timer)
           (deadline (timer--time timer))
           (latest my/key-observer--save-latest-timer))
      (timer-set-function timer #'my/key-observer--save-h nil)
      (dotimes (_ 3) (load my/key-observer-test--source nil t))
      (should (eq session my/key-observer--session))
      (should (eq checkpoint my/key-observer--checkpoint))
      (should (eq pending my/key-observer--pending))
      (should (eq timer my/key-observer--save-timer))
      (should (eq (timer--function timer) #'my/key-observer--periodic-save-h))
      (should (equal deadline (timer--time timer)))
      (should (eq latest my/key-observer--save-latest-timer))
      (should (= (cl-count #'my/key-observer--pre-h pre-command-hook) 1)))))

