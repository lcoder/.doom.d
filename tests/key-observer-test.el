(ert-deftest my/key-observer-background-checks-time-budget-between-records ()
  (my/key-observer-test--isolated
    (dotimes (index 5) (my/key-observer-test--queue index 1793548800))
    (my/key-observer--begin-checkpoint)
    (my/key-observer--log-name 1793548800)
    (let ((clock 0.0)
          (serialize (symbol-function 'json-serialize)))
      (cl-letf (((symbol-function 'float-time) (lambda (&rest _) clock))
                ((symbol-function 'json-serialize)
                 (lambda (&rest arguments)
                   (cl-incf clock 0.005) (apply serialize arguments))))
        (my/key-observer--flush-slice t)))
    (should (= (length (my/key-observer-test--records)) 2))
    (should (= (length (plist-get my/key-observer--checkpoint :records)) 3))))

(ert-deftest my/key-observer-partial-utf8-append-retries-without-duplicates ()
  (my/key-observer-test--isolated
    (my/key-observer-test--queue "汉字")
    (my/key-observer--begin-checkpoint)
    (let ((write (symbol-function 'write-region)))
      (cl-letf (((symbol-function 'write-region)
                 (lambda (start end file &optional append &rest arguments)
                   (if append
                       (let ((split (1+ (string-search (encode-coding-string "汉" 'utf-8)
                                                       start))))
                         (apply write (substring start 0 split) nil file append arguments)
                         (error "Simulated partial UTF-8 write"))
                     (apply write start end file append arguments)))))
        (should-error (my/key-observer--flush-slice))))
    (should (plist-get my/key-observer--checkpoint :append))
    (my/key-observer--save)
    (should (equal (mapcar (lambda (record) (plist-get record :keys))
                           (my/key-observer-test--records))
                   '("汉字")))))

(ert-deftest my/key-observer-full-append-reported-as-error-is-not-written-twice ()
  (my/key-observer-test--isolated
    (my/key-observer-test--queue 1)
    (my/key-observer--begin-checkpoint)
    (let ((write (symbol-function 'write-region)))
      (cl-letf (((symbol-function 'write-region)
                 (lambda (start end file &optional append &rest arguments)
                   (prog1 (apply write start end file append arguments)
                     (when append (error "Simulated error after complete append"))))))
        (should-error (my/key-observer--flush-slice))))
    (my/key-observer--save)
    (should (= (length (my/key-observer-test--records)) 1))))

(ert-deftest my/key-observer-midnight-save-error-pauses-and-retains-new-batch ()
  (my/key-observer-test--isolated
    (let* ((before (float-time (encode-time 59 59 23 1 11 2026 "Asia/Singapore")))
           (after (1+ before))
           (write (symbol-function 'write-region)))
      (my/key-observer-test--queue 1 before)
      (my/key-observer-test--queue 2 after)
      (my/key-observer--periodic-save-h)
      (cl-letf (((symbol-function 'input-pending-p) (lambda (&rest _) nil))
                ((symbol-function 'write-region)
                 (lambda (start end file &optional append &rest arguments)
                   (if (and append (string-suffix-p "commands-2026-11-02.jsonl" file))
                       (progn (my/key-observer-test--queue 3 (+ after 1))
                              (error "Simulated second-day failure"))
                     (apply write start end file append arguments)))))
        (my/key-observer--background-save-h))
      (should (equal (plist-get my/key-observer--session :status) "paused"))
      (should (= (length (my/key-observer-test--records)) 1))
      (should (= (length my/key-observer--pending) 1))
      (should-not (append timer-list timer-idle-list))
      (my/key-observer-resume)
      (should (equal (mapcar (lambda (record) (plist-get record :keys))
                             (cl-remove-if-not (lambda (record)
                                                 (equal (plist-get record :type) "command"))
                                               (my/key-observer-test--records)))
                     '("1" "2" "3")))
      (should (equal (plist-get my/key-observer--session :status) "recording")))))

