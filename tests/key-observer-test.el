;;; key-observer-test.el -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'keycast)
(require 'my-key-observer)

(defconst my/key-observer-test--source
  (expand-file-name "../+key-observer.el"
                    (file-name-directory (or load-file-name buffer-file-name)))
  "Recorder source used for reload acceptance.")

(defvar my/key-observer-test--keys [])

(defmacro my/key-observer-test--isolated (&rest body)
  "Run BODY with private recorder state, timers, hooks, files and Keycast data."
  (declare (indent 0) (debug t))
  `(let* ((directory (make-temp-file "doom-key-observer-test-" t))
          (my/key-observer-directory directory)
          (my/key-observer--session
           (list :version 2 :id "test" :directory directory :status "recording"
                 :continuous t :events 0 :saved-at nil :error nil))
          (my/key-observer--pending nil)
          (my/key-observer--checkpoint nil)
          (my/key-observer--frequencies (make-hash-table :test #'equal))
          (my/key-observer--contexts (make-hash-table :test #'eql))
          (my/key-observer--log-names (make-hash-table :test #'eql))
          (my/key-observer--control-state nil)
          (my/key-observer--saved-control-state nil)
          (my/key-observer--save-timer nil)
          (my/key-observer--deadline-timer nil)
          (my/key-observer--finish-timer nil)
          (my/key-observer--save-idle-timer nil)
          (my/key-observer--save-latest-timer nil)
          (my/key-observer--save-continuation-timer nil)
          (my/key-observer--save-requested nil)
          (my/key-observer--save-forced nil)
          (my/key-observer--save-yielded nil)
          (my/key-observer--last-save-metrics nil)
          (my/key-observer--owns-keycast nil)
          (my/key-observer--inhibit nil)
          (my/key-observer--replay-source nil)
          (my/key-observer--mode-line-status :unknown)
          (panel-name (generate-new-buffer-name " *key-observer-test-panel*"))
          (my/key-observer--panel panel-name)
          (my/key-observer-test--keys [])
          (keycast--this-command-keys nil)
          (keycast--this-command-desc nil)
          (keycast--minibuffer-exited nil)
          (keycast--command-repetitions 0)
          (keycast--reading-passwd nil)
          (keycast-invisible-mode nil)
          (keycast-mode-line-mode nil)
          (keycast-header-line-mode nil)
          (keycast-tab-bar-mode nil)
          (keycast-log-mode nil)
          (timer-list nil)
          (timer-idle-list nil)
          (pre-command-hook nil)
          (post-command-hook nil)
          (kill-emacs-hook nil)
          (after-init-hook nil)
          (global-mode-string nil)
          (after-init-time nil))
     (unwind-protect
         (cl-letf (((symbol-function 'this-command-keys-vector)
                    (lambda () my/key-observer-test--keys))
                   ((symbol-function 'this-single-command-keys)
                    (lambda () my/key-observer-test--keys))
                   ((symbol-function 'keycast-invisible-mode)
                    (lambda (argument) (setq keycast-invisible-mode (> argument 0))))
                   ((symbol-function 'evil-execute-repeat-info) #'ignore)
                   ((symbol-function 'read-passwd) #'ignore)
                   ((symbol-function 'force-mode-line-update) #'ignore)
                   ((symbol-function 'display-warning) #'ignore))
           ,@body)
       (dolist (timer (append timer-list timer-idle-list)) (cancel-timer timer))
       (when-let* ((buffer (get-buffer panel-name))) (kill-buffer buffer))
       (delete-directory directory t))))

(defun my/key-observer-test--queue (index &optional timestamp)
  "Queue one identifiable command INDEX at TIMESTAMP."
  (my/key-observer--queue-command
   (list :type "command" :time (or timestamp (float-time))
         :keys (format "%s" index) :command "probe" :source "manual"
         :mode "fundamental-mode")
   'fundamental-mode "probe" "manual"))

(defun my/key-observer-test--json (name)
  "Read a private fixture's JSON file NAME."
  (with-temp-buffer
    (insert-file-contents (expand-file-name name my/key-observer-directory))
    (json-parse-buffer :object-type 'plist :array-type 'list
                       :null-object nil :false-object :false)))

(defun my/key-observer-test--records ()
  "Read the private fixture's command logs in filename order."
  (cl-loop for file in (directory-files my/key-observer-directory t "\\`commands.*jsonl\\'")
           append
           (with-temp-buffer
             (insert-file-contents file)
             (cl-loop for line in (split-string (buffer-string) "\n" t)
                      collect (json-parse-string line :object-type 'plist
                                                 :null-object nil :false-object :false)))))

(defun my/key-observer-test--input (command keys &optional following resolved)
  "Collect COMMAND invoked with KEYS, FOLLOWING keys and optional RESOLVED command."
  (let* ((this-command command)
         (this-original-command command)
         (last-command nil)
         (last-command-event (and (> (length keys) 0) (aref keys (1- (length keys)))))
         (my/key-observer-test--keys keys))
    (my/key-observer--pre-h)
    (setq my/key-observer-test--keys (or following keys)
          this-command (or resolved command))
    (keycast--update)
    (my/key-observer--post-h)))

(defun my/key-observer-test--drain-background ()
  "Run scheduled background work without waiting for real timer deadlines."
  (cl-letf (((symbol-function 'input-pending-p) (lambda (&rest _) nil)))
    (while my/key-observer--save-requested (my/key-observer--background-save-h))))

(ert-deftest my/key-observer-cache-partitions-singapore-midnight-and-legacy ()
  (my/key-observer-test--isolated
    (let* ((before (float-time (encode-time 59 59 23 1 11 2026 "Asia/Singapore")))
           (after (1+ before))
           (original (symbol-function 'format-time-string))
           (calls 0))
      (cl-letf (((symbol-function 'format-time-string)
                 (lambda (&rest arguments)
                   (cl-incf calls) (apply original arguments))))
        (dotimes (_ 500)
          (should (equal (my/key-observer--log-name before) "commands-2026-11-01.jsonl"))
          (should (equal (my/key-observer--log-name after) "commands-2026-11-02.jsonl")))
        (should (= calls 2)))
      (my/key-observer-test--queue 1 before)
      (my/key-observer-test--queue 2 after)
      (my/key-observer--save)
      (should (file-exists-p (expand-file-name "commands-2026-11-01.jsonl" directory)))
      (should (file-exists-p (expand-file-name "commands-2026-11-02.jsonl" directory)))
      (setf (plist-get my/key-observer--session :continuous) :false)
      (should (equal (my/key-observer--log-name before) "commands.jsonl"))
      (my/key-observer-test--queue 3 after)
      (my/key-observer--save)
      (should (file-exists-p (expand-file-name "commands.jsonl" directory))))))

(ert-deftest my/key-observer-checkpoint-freezes-counts-and-preserves-new-input ()
  (my/key-observer-test--isolated
    (dotimes (index 3) (my/key-observer-test--queue index))
    (my/key-observer--begin-checkpoint)
    (should (= (plist-get my/key-observer--checkpoint :record-count) 3))
    (let ((cutoff (plist-get (plist-get my/key-observer--checkpoint :session) :saved-at)))
      (my/key-observer-test--queue 3 (+ cutoff 1))
      (while my/key-observer--checkpoint (my/key-observer--flush-slice t))
      (should (= (plist-get (my/key-observer-test--json "session.json") :events) 3))
      (should (= (plist-get (my/key-observer-test--json "session.json") :saved-at) cutoff))
      (should (= (plist-get (car (plist-get (my/key-observer-test--json "frequencies.json") :rows))
                            :count) 3))
      (should (= (length my/key-observer--pending) 1))
      (my/key-observer--save)
      (should (equal (mapcar (lambda (record) (plist-get record :keys))
                             (my/key-observer-test--records))
                     '("0" "1" "2" "3")))
      (should (= (plist-get (my/key-observer-test--json "session.json") :events) 4))
      (should-not my/key-observer--pending))
    (dolist (file (directory-files directory t "\\.jsonl?\\'"))
      (should (= (logand #o777 (file-modes file)) #o600)))))

(ert-deftest my/key-observer-metadata-write-skips-lsp-file-rename-notifications ()
  (skip-unless (require 'lsp-mode nil t))
  (my/key-observer-test--isolated
    (let ((lsp-apply-edits-after-file-operations t)
          (file (expand-file-name "metadata.json" directory))
          requests)
      ;; Model a server whose broad rename filter also matches runtime files.
      ;; Keep the real rename advice and file operations, but avoid server I/O.
      (cl-letf (((symbol-function 'lsp--send-will-rename-files-p)
                 (lambda (_path) t))
                ((symbol-function 'lsp-request)
                 (lambda (method _params &rest _options)
                   (push method requests)
                   nil)))
        (my/key-observer--write-json file '(:version 1))
        (my/key-observer--write-json file '(:version 2))
        (should-not requests)
        (should (= (plist-get (my/key-observer-test--json "metadata.json") :version) 2))
        (should (= (logand #o777 (file-modes file)) #o600))
        (should (equal (directory-files directory nil directory-files-no-dot-files-regexp)
                       '("metadata.json")))
        ;; Normal project renames must still notify LSP outside the writer.
        (rename-file file (expand-file-name "renamed.json" directory))
        (should (equal requests '("workspace/willRenameFiles")))))))

(ert-deftest my/key-observer-background-honors-idle-max-delay-and-input ()
  (my/key-observer-test--isolated
    (my/key-observer-test--queue 1)
    (my/key-observer--periodic-save-h)
    (let ((idle my/key-observer--save-idle-timer)
          (latest my/key-observer--save-latest-timer))
      (dotimes (_ 3) (my/key-observer--periodic-save-h))
      (should (eq idle my/key-observer--save-idle-timer))
      (should (eq latest my/key-observer--save-latest-timer))
      (should (equal (timer--time idle) (seconds-to-time my/key-observer-save-idle-delay)))
      (should (equal (timer--args latest) '(t)))
      (should-not (file-exists-p (expand-file-name "session.json" directory))))
    (cl-letf (((symbol-function 'input-pending-p) (lambda (&rest _) t)))
      (my/key-observer--background-save-h)
      (should-not my/key-observer--checkpoint)
      (should my/key-observer--save-latest-timer)
      (should my/key-observer--save-continuation-timer)
      ;; The maximum-delay callback gives queued input one turn, then makes progress.
      (setq my/key-observer--save-yielded nil)
      (my/key-observer--background-save-h t)
      (should-not my/key-observer--checkpoint)
      (my/key-observer--background-save-h)
      (should (or my/key-observer--checkpoint
                  (file-exists-p (expand-file-name "session.json" directory)))))
    (my/key-observer-test--drain-background)
    (should (= (length (my/key-observer-test--records)) 1))
    (should-not (append timer-list timer-idle-list))))

