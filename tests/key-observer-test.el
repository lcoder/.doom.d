      (let ((major-mode 'dart-ts-mode) (evil-state 'normal) (current-prefix-arg 15))
        (cl-letf (((symbol-function 'json-serialize)
                   (lambda (&rest _) (ert-fail "Command hook serialized JSON")))
                  ((symbol-function 'write-region)
